# Copy to .env (git-ignored) and fill in. chmod 600 .env
# Real environment variables override this file.
DEEPINFRA_API_KEY=
# Opt-ins. Both are needed for the full demo (run_demo.sh --ui also sets them):
GUARDIAN_ALLOW_EXTERNAL_MODELS=1    # allow sending run metadata to DeepInfra
GUARDIAN_ALLOW_REGISTRY_ACCESS=1    # allow npm registry access for lockfile/install in validation
#
# GUARDIAN_SANDBOX_IMAGE=             # digest-pinned image for the docker sandbox (optional)
# GUARDIAN_PRICE_IN_PER_M=            # USD per million tokens, only for --budget-usd
# GUARDIAN_PRICE_OUT_PER_M=
#
# Let the server push an approved, validated fix as a NEW guardian/fix-* branch (never the
# default branch, never merged). Use a fine-grained token limited to ONE repository with
# "Contents: read and write" only. Leave both unset to push yourself with scripts/push_fix.sh.
# GUARDIAN_ALLOW_PUSH=1
# GUARDIAN_GITHUB_TOKEN=
